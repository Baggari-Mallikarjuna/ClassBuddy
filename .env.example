SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=True

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=your-email@example.com
MAIL_SENDER_NAME=ClassBuddy
MAIL_TIMEOUT=15

REMINDER_MINUTES_BEFORE=15

# Web workers do not start schedulers by default. `python app.py` starts one.
# Set REMINDER_SCHEDULER_ENABLED=True only for a single dedicated app process.

# Optional: set only after moving the database outside OneDrive.
# CLASSBUDDY_DATABASE=C:\ClassBuddy\database\classbuddy.db
# CLASSBUDDY_SQLITE_WAL=True
